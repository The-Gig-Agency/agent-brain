{
  "name": "agent-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "eval:debugging": "npm run build && node dist/cognitive-router/run-debugging-v1.js",
    "eval:replays": "npm run build && node dist/cognitive-router/run-real-replays-v1.js",
    "eval:replays:tight": "npm run build && node dist/cognitive-router/run-real-replays-v0.6a-tight.js",
    "eval:replays:diverse": "npm run build && node dist/cognitive-router/run-real-replays-v0.6b-diverse.js",
    "eval:replays:v2": "npm run build && node dist/cognitive-router/run-real-replays-v0.6c-candidates.js",
    "eval:replays:v2:tight": "npm run build && node dist/cognitive-router/run-real-replays-v0.6c-tight.js",
    "eval:replays:v0.6d": "npm run build && node dist/cognitive-router/run-real-replays-v0.6d.js",
    "eval:replays:v0.6e": "npm run build && node dist/cognitive-router/run-real-replays-v0.6e.js",
    "eval:replays:v0.6f": "npm run build && node dist/cognitive-router/run-real-replays-v0.6f.js",
    "eval:replays:v0.7": "npm run build && node dist/cognitive-router/run-real-replays-v0.7.js",
    "eval:replays:v0.7a": "npm run build && node dist/cognitive-router/run-real-replays-v0.7a.js",
    "eval:replays:v0.7b": "npm run build && node dist/cognitive-router/run-real-replays-v0.7b.js",
    "eval:replays:v0.8": "npm run build && node dist/cognitive-router/run-real-replays-v0.8.js",
    "eval:frozen:debug:v1": "npm run build && node dist/cognitive-router/run-real-replays-v0.8.js",
    "eval:media:v0.1": "npm run build && node dist/cognitive-router/run-media-eval-v0.1.js",
    "eval:frozen:media:v1": "npm run build && node dist/cognitive-router/run-media-eval-v0.1.js",
    "eval:transition-candidate:v0.1": "npm run build && node dist/cognitive-router/run-transition-candidate-v0.1.js"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
